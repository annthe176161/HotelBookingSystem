@model HotelBookingSystem.ViewModels.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="login-container">
    <div class="row">
        <div class="col-lg-6 login-banner d-none d-lg-block">
            <div class="overlay"></div>
            <div class="banner-content">
                <h1>Bảo mật tài khoản</h1>
                <p>Thay đổi mật khẩu thường xuyên giúp bảo vệ tài khoản của bạn an toàn hơn</p>
            </div>
        </div>
        <div class="col-lg-6 col-md-12 login-form-container">
            <div class="login-form-wrapper">
                <div class="login-header text-center">
                    <a href="/" class="login-logo">
                        <i class="fas fa-hotel"></i>
                    </a>
                    <h2>Đổi mật khẩu</h2>
                    <p>Cập nhật mật khẩu để bảo vệ tài khoản của bạn</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="ChangePassword" asp-controller="Account" method="post" class="login-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @Html.AntiForgeryToken()

                    <div class="form-floating mb-3">
                        <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Mật khẩu hiện tại" required />
                        <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        <div class="password-toggle">
                            <i class="fas fa-eye" onclick="togglePassword(this)"></i>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="NewPassword" class="form-control" type="password" placeholder="Mật khẩu mới" required />
                        <label asp-for="NewPassword">Mật khẩu mới</label>
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <div class="password-toggle">
                            <i class="fas fa-eye" onclick="togglePassword(this)"></i>
                        </div>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Xác nhận mật khẩu mới" required />
                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        <div class="password-toggle">
                            <i class="fas fa-eye" onclick="togglePassword(this)"></i>
                        </div>
                    </div>

                    <div class="password-strength mb-3" style="display: none;">
                        <div class="strength-meter">
                            <div class="strength-meter-fill"></div>
                        </div>
                        <small class="strength-text text-muted">Độ mạnh mật khẩu: <span class="strength-level">Yếu</span></small>
                    </div>

                    <div class="password-requirements mb-3" style="display: none;">
                        <strong class="d-block mb-2">Yêu cầu mật khẩu:</strong>
                        <ul class="mb-0">
                            <li id="req-length">Ít nhất 8 ký tự</li>
                            <li id="req-uppercase">Có chữ hoa (A-Z)</li>
                            <li id="req-lowercase">Có chữ thường (a-z)</li>
                            <li id="req-number">Có số (0-9)</li>
                            <li id="req-special">Có ký tự đặc biệt (!@$%^&*)</li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-key me-2"></i>Cập nhật mật khẩu
                        </button>
                    </div>

                    <div class="login-divider">
                        <span>hoặc</span>
                    </div>

                    <div class="register-link text-center">
                        <a asp-action="Profile" asp-controller="Account" class="btn btn-outline-secondary">
                            <i class="fas fa-user me-2"></i>Về trang Profile
                        </a>
                        <br>
                        <small class="text-muted mt-2">
                            <a asp-action="Logout" asp-controller="Account" class="text-decoration-none">
                                <i class="fas fa-sign-out-alt me-1"></i>Đăng xuất
                            </a>
                        </small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/change-password.js" asp-append-version="true"></script>
}
