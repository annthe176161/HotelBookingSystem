@{
    ViewData["Title"] = "Đã gửi liên kết";
}

<div class="login-container">
    <div class="row">
        <div class="col-lg-6 login-banner d-none d-lg-block">
            <div class="overlay"></div>
            <div class="banner-content">
                <h1>Email đã được gửi</h1>
                <p>Chúng tôi đã gửi hướng dẫn khôi phục mật khẩu đến email của bạn. Vui lòng kiểm tra hộp thư!</p>
            </div>
        </div>
        <div class="col-lg-6 col-md-12 login-form-container">
            <div class="login-form-wrapper">
                <div class="login-header text-center">
                    <a href="/" class="login-logo">
                        <i class="fas fa-hotel"></i>
                    </a>
                    <div class="text-center mb-4">
                        <i class="fas fa-envelope-circle-check text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2>Kiểm tra email của bạn</h2>
                    <p>Nếu email tồn tại trong hệ thống, liên kết đặt lại mật khẩu đã được gửi đến hộp thư của bạn.</p>
                </div>

                <div class="alert alert-success text-center">
                    <i class="fas fa-info-circle"></i>
                    <strong>Lưu ý:</strong> Vui lòng kiểm tra cả thư mục spam/junk mail nếu không thấy email trong hộp thư chính.
                </div>

                <div class="d-grid gap-2 mb-3">
                    <a class="btn btn-primary" asp-action="Login" asp-controller="Account">
                        <i class="fas fa-arrow-left me-2"></i>Về trang đăng nhập
                    </a>
                </div>

                <div class="login-divider">
                    <span>cần trợ giúp?</span>
                </div>

                <div class="register-link text-center">
                    <small class="text-muted">
                        Không nhận được email? 
                        <a asp-action="ForgotPassword" asp-controller="Account" class="text-decoration-none">Gửi lại</a>
                    </small>
                    <br>
                    <small class="text-muted mt-2">
                        Liên hệ hỗ trợ: 
                        <a href="mailto:info@luxuryhotel.com" class="text-decoration-none">info@luxuryhotel.com</a>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
