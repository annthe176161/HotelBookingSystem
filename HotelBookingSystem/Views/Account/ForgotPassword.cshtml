@model HotelBookingSystem.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="login-container">
    <div class="row">
        <div class="col-lg-6 login-banner d-none d-lg-block">
            <div class="overlay"></div>
            <div class="banner-content">
                <h1>Khôi phục tài khoản</h1>
                <p>Đừng lo lắng! Chúng tôi sẽ giúp bạn lấy lại quyền truy cập vào tài khoản một cách an toàn và nhanh chóng</p>
            </div>
        </div>
        <div class="col-lg-6 col-md-12 login-form-container">
            <div class="login-form-wrapper">
                <div class="login-header text-center">
                    <a href="/" class="login-logo">
                        <i class="fas fa-hotel"></i>
                    </a>
                    <h2>Quên mật khẩu</h2>
                    <p>Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu</p>
                </div>

                <form asp-action="ForgotPassword" asp-controller="Account" method="post" class="login-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    @Html.AntiForgeryToken()
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Email" required />
                        <label asp-for="Email">Địa chỉ Email</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-paper-plane me-2"></i>Gửi liên kết đặt lại
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="mb-2">
                            <i class="fas fa-info-circle text-info me-2"></i>
                            <small class="text-muted">Kiểm tra hộp thư và thư mục spam</small>
                        </p>
                    </div>

                    <div class="login-divider">
                        <span>hoặc</span>
                    </div>

                    <div class="register-link text-center">
                        <a asp-action="Login" asp-controller="Account">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại đăng nhập
                        </a>
                        <br>
                        <small class="text-muted mt-2">
                            Chưa có tài khoản? 
                            <a asp-action="Register" asp-controller="Account" class="text-decoration-none">Đăng ký ngay</a>
                        </small>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/forgot-password.js" asp-append-version="true"></script>
}
