@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="login-container">
    <div class="row">
        <div class="col-lg-6 login-banner d-none d-lg-block">
            <div class="overlay"></div>
            <div class="banner-content">
                <h1>Đặt lại mật khẩu thành công</h1>
                <p>Tài khoản của bạn đã được bảo mật với mật khẩu mới</p>
            </div>
        </div>
        <div class="col-lg-6 col-md-12 login-form-container">
            <div class="login-form-wrapper">
                <div class="login-header text-center">
                    <a href="/" class="login-logo">
                        <i class="fas fa-hotel"></i>
                    </a>
                    <div class="success-icon mb-4">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="text-success">Mật khẩu đã được cập nhật!</h2>
                    <p class="text-muted">Tài khoản của bạn đã được bảo mật thành công. Bạn có thể đăng nhập bằng mật khẩu mới.</p>
                </div>

                <div class="text-center">
                    <div class="alert alert-success mb-4">
                        <i class="fas fa-shield-alt me-2"></i>
                        <strong>Bảo mật tài khoản thành công!</strong><br>
                        <small>Mật khẩu mới đã được lưu và mã hóa an toàn.</small>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <a class="btn btn-primary btn-lg" asp-action="Login" asp-controller="Account">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập ngay
                        </a>
                    </div>

                    <div class="register-link text-center">
                        <a asp-action="Index" asp-controller="Home">
                            <i class="fas fa-home me-2"></i>Về trang chủ
                        </a>
                    </div>
                </div>

                <div class="mt-4 text-center">
                    <div class="security-tips">
                        <small class="text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            <strong>Lời khuyên bảo mật:</strong> Hãy đăng xuất khỏi tất cả thiết bị khác và đăng nhập lại bằng mật khẩu mới.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/css/reset-password-confirmation.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/reset-password-confirmation.js" asp-append-version="true"></script>
}
